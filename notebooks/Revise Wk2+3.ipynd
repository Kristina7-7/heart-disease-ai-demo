              "type": "dataframe",
              "variable_name": "coef_df",
              "summary": "{\n  \"name\": \"coef_df\",\n  \"rows\": 28,\n  \"fields\": [\n    {\n      \"column\": \"Feature\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 28,\n        \"samples\": [\n          \"cat__restecg_2.0\",\n          \"cat__sex_0.0\",\n          \"cat__exang_1.0\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Coefficient\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.5107385067404189,\n        \"min\": -0.9563244200851472,\n        \"max\": 1.4287938176304187,\n        \"num_unique_values\": 28,\n        \"samples\": [\n          -0.21619168835302582,\n          0.6597408237360326,\n          -0.2204104837906009\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
          },
          "metadata": {},
          "execution_count": 135
