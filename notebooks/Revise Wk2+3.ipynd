            "weighted avg       0.51      0.57      0.54        61\n",
            "\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## DummyClassifier Model"
      ],
      "metadata": {
        "id": "DsA5_Ina2Nrz"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.dummy import DummyClassifier\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix, classification_report"
      ],
      "metadata": {
        "id": "DgjTsyXLRwgz"
      },
      "execution_count": 130,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#DummyClassifier verfication code\n",
        "dummy_model = DummyClassifier( strategy=\"most_frequent\" )\n",
        "dummy_model.fit( X_train, y_train.values.ravel() )\n",
        "dummy_pred = dummy_model.predict(X_test)\n",
        "dummy_accuracy = accuracy_score( y_test.values.ravel(), dummy_pred )\n",
        "print(\"Dummy accuracy:\", dummy_accuracy)\n",
        "print(\"Confusion matrix:\")\n",
        "print(confusion_matrix(y_test, dummy_pred))\n",
        "print( classification_report( y_test, dummy_pred, zero_division=0 ) )"
      ],
      "metadata": {
        "id": "EhdFE1XhT63Y",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "43e6c683-7b4b-4ed5-b54e-cbff31218911"
      },
      "execution_count": 131,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Dummy accuracy: 0.5409836065573771\n",
            "Confusion matrix:\n",
            "[[33  0  0  0  0]\n",
            " [11  0  0  0  0]\n",
            " [ 7  0  0  0  0]\n",
            " [ 7  0  0  0  0]\n",
            " [ 3  0  0  0  0]]\n",
            "              precision    recall  f1-score   support\n",
            "\n",
            "           0       0.54      1.00      0.70        33\n",
            "           1       0.00      0.00      0.00        11\n",
            "           2       0.00      0.00      0.00         7\n",
            "           3       0.00      0.00      0.00         7\n",
            "           4       0.00      0.00      0.00         3\n",
            "\n",
            "    accuracy                           0.54        61\n",
            "   macro avg       0.11      0.20      0.14        61\n",
            "weighted avg       0.29      0.54      0.38        61\n",
            "\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "The DummyClassifier always predicts the most frequent class (Class 0) and serves as a baseline model.\n",
        "\n",
        "It achieved **54.1%** accuracy, while Logistic Regression achieved **65.6%** and Random Forest achieved **57.4%**. Although the trained models performed better than the baseline, the improvement was relatively small.\n",
        "\n",
        "Logistic Regression correctly predicted about 6 more patients than the DummyClassifier, while Random Forest did less improve the overall accuracy beyond the baseline.\n",
        "\n",
        "The confusion matrix shows that the DummyClassifier predicted every patient as Class 0. Therefore, it had zero recall and F1-score for Classes 1–4. This demonstrates why accuracy alone can be misleading in an imbalanced multiclass dataset."
      ],
      "metadata": {
        "id": "J9WYIeNo4QCQ"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Confusion Matrix Graph"
      ],
      "metadata": {
        "id": "eYmYZCr78g7v"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Import pyplot for graphing, Display for making a confusion matrix into a graph\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import ConfusionMatrixDisplay"
      ],
      "metadata": {
        "id": "tDbWcpbc8i_v"
      },
      "execution_count": 132,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Create the confusion metric\n",
        "ConfusionMatrixDisplay.from_estimator(\n",
        "    pipeline,\n",
        "    X_test,\n",
        "    y_test.values.ravel(),\n",
        "    cmap=\"Blues\"\n",
        ")\n",
        "\n",
        "plt.title(\"Logistic Regression Confusion Matrix\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 472
        },
        "id": "8KhxtjHL8tNo",
        "outputId": "0fe3002e-fdf4-4263-cb91-d9fdce5254af"
      },
      "execution_count": 133,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 640x480 with 2 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Observation:\n",
        "The confusion matrix shows that Logistic Regression predicts **Class 0** very well, but its performance on **Classes 1, 2, and 4** is much weaker. Many minority-class samples are misclassified as **Class 0 or Class 3**, suggesting that the model is influenced by class imbalance and has difficulty separating similar classes.\n",
        "\n",
        "Overall, Logistic Regression performed reasonably well as a baseline model, but the confusion matrix suggests that predicting multiple heart disease classes is challenging. The overlap between classes may reduce the model's ability to separate patients with similar clinical characteristics."
      ],
      "metadata": {
        "id": "kHm-TovU84ef"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Get coefficients from Logistic Regression inside the pipeline\n",
        "lr_model = pipeline.named_steps[\"model\"]\n",
        "coefficients = model.coef_[0]\n",
        "\n",
        "# Get the transformed feature names\n",
        "feature_names = pipeline.named_steps[\n",
        "    \"preprocessor\"\n",
        "].get_feature_names_out()\n",
        "\n",
        "# Each row corresponds to one class\n",
        "print(\"Classes:\", lr_model.classes_)\n",
        "print(\"Coefficient shape:\", lr_model.coef_.shape)\n",
        "\n",
        "# Coefficients for Class 0\n",
        "coefficients = lr_model.coef_[0]\n",
        "\n",
        "for feature, coef in zip(feature_names, coefficients):\n",
        "    print(feature, \":\", round(coef, 3))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
